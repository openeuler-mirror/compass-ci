. ../defconfig.sh

load_cci_defaults

docker_skip_rebuild "alpine38:git-mirror"

# TODO: cbs has been retired; keep this legacy checkout for now and clean it up
# after the remaining container build inputs are audited.
download_repo "cbs" "$git_branch_cbs"

docker build --no-cache -t alpine38:git-mirror .

push_image_remote "alpine38:git-mirror"
