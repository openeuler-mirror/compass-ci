#!/bin/bash
# SPDX-License-Identifier: MulanPSL-2.0+

set -e

. ../defconfig.sh

load_cci_defaults

docker_skip_rebuild "debian:data-api"

script_dir=$(cd "$(dirname "$0")" && pwd)
repo_root=$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null || (cd "$script_dir/../.." && pwd))
build_context=$(mktemp -d /tmp/data-api-build.XXXXXX)
lkp_src=${LKP_SRC:-"$(dirname "$repo_root")/lkp-tests"}

cleanup()
{
	rm -rf "$build_context"
}

copy_worktree()
{
	local src="$1"
	local dest="$2"

	mkdir -p "$dest"

	if git -C "$src" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		git -C "$src" ls-files -z | tar -C "$src" --null -T - -cf - | tar -C "$dest" -xf -
	else
		tar -C "$src" --exclude='.git' -cf - . | tar -C "$dest" -xf -
	fi
}

trap cleanup EXIT INT TERM

cp -a "$script_dir/Dockerfile" "$build_context/"
cp -a "$script_dir/data-api" "$build_context/"
cp -a "$script_dir/conf" "$build_context/"

# Build from the local checkout so data-api does not depend on the retired cbs repo.
copy_worktree "$repo_root" "$build_context/compass-ci"

# data-api does not need lkp-tests at build time, but keep the mount point for runtime.
if [ -d "$lkp_src" ]; then
	copy_worktree "$lkp_src" "$build_context/lkp-tests"
else
	mkdir -p "$build_context/lkp-tests"
fi

docker build --no-cache -t debian:data-api "$build_context"

push_image_remote "debian:data-api"
